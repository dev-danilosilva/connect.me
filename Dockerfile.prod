# ---- Elm stage: compile the Elm programs, one bundle each ----
# The bundles aren't committed; every image build compiles them from elm/.
# Keep this list in sync with PROGRAMS in frontend/elm.py.
FROM node:24-slim AS elm-builder

# The slim image has no CA bundle, and `elm make` needs HTTPS to fetch
# packages from package.elm-lang.org.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g elm@0.19.2-0

WORKDIR /elm

COPY elm/elm.json .
COPY elm/src ./src
RUN elm make src/PageEditor/Main.elm --optimize --output=page_editor.js \
    && elm make src/VisitsChart/Main.elm --optimize --output=visits_chart.js

# ---- Build stage: compile/install dependencies ----
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ---- Runtime stage: minimal image, no build tools ----
FROM python:3.12-slim AS web

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUSERBASE=/home/django/.local \
    PATH=/home/django/.local/bin:$PATH

RUN addgroup --system django && adduser --system --ingroup django django

WORKDIR /app

COPY --from=builder --chown=django:django /root/.local /home/django/.local
COPY --chown=django:django . .
COPY --from=elm-builder --chown=django:django /elm/page_editor.js /elm/visits_chart.js static/js/

RUN mkdir -p /app/staticfiles && chown django:django /app/staticfiles

USER django

# Settings refuse to load without SECRET_KEY when DEBUG=False. collectstatic
# never signs anything, so give it a throwaway key scoped to this one command;
# the real key is only provided at runtime.
RUN SECRET_KEY=collectstatic-build-only python manage.py collectstatic --noinput

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/admin/login/')"

ENTRYPOINT ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn linktree_project.wsgi:application --bind 0.0.0.0:8000 --workers ${GUNICORN_WORKERS:-3} --access-logfile - --error-logfile -"]

# ---- nginx stage: reverse proxy with this build's static files baked in ----
# Baking the files in (rather than sharing a volume with `web`) means every
# deploy serves exactly the static files it was built with: a named volume is
# only filled from the image while empty, so it would keep serving the first
# deploy's CSS/JS forever. This is the last stage, so build `web` explicitly
# with `--target web` (docker-compose.prod.yml sets the target for both).
FROM nginx:1.27-alpine AS nginx

COPY --from=web /app/staticfiles /app/staticfiles

# Reload nginx periodically so renewed Let's Encrypt certificates are picked up.
COPY nginx-reload-certs.sh /docker-entrypoint.d/40-reload-certs.sh
