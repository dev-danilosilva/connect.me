# Optional while DEBUG=True (a dev-only fallback key is used instead).
# Mandatory once DEBUG=False -- Django refuses to start without it.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=linktree
POSTGRES_USER=linktree
POSTGRES_PASSWORD=linktree
# localhost/5432 because docker-compose.yml publishes the db container's
# port to the host for the local-venv app to connect to (see README).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Required only for docker-compose.prod.yml + init-letsencrypt.sh
DOMAIN=example.com
LETSENCRYPT_EMAIL=you@example.com

# Optional -- defaults shown. EMAIL_BACKEND defaults to the console backend
# (prints emails instead of sending them); point it at
# django.core.mail.backends.smtp.EmailBackend (+ EMAIL_HOST/PORT/etc, see
# Django's email docs) to actually send mail in production.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=webmaster@localhost
# DJANGO_LOG_LEVEL=INFO
